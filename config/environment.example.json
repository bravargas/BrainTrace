    { "Name": "APP1", "Roles": ["APP"], "Inbox": "\\\\APP1\\BrainTrace$\\Inbox", "ExpectedConfigRevision": "qa-app1-1", "ExpectedConfigHash": "3333333333333333333333333333333333333333333333333333333333333333" },
    { "Name": "APP2", "Roles": ["APP"], "Inbox": "\\\\APP2\\BrainTrace$\\Inbox", "ExpectedConfigRevision": "qa-app2-1", "ExpectedConfigHash": "4444444444444444444444444444444444444444444444444444444444444444" },
